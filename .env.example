# --- AI providers ---
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
AI_PROVIDER=anthropic

# --- Security ---
# JWTs are signed with RS256. Generate a key pair and base64-encode both parts.
# When unset, dev generates an ephemeral pair; the prod profile REQUIRES these.
ORBIT_JWT_PRIVATE_KEY=
ORBIT_JWT_PUBLIC_KEY=
# base64 of a 16/24/32-byte key. Required in prod (Slack token encryption).
SLACK_TOKEN_ENC_KEY=
# Bootstrap admin password (blank -> random, logged once at first boot).
ORBIT_ADMIN_PASSWORD=
# Comma-separated email domains treated as internal/company addresses,
# e.g. INTERNAL_EMAIL_DOMAINS=example.com,example.org
# Blank = no restriction (any domain may link via Slack; help text shows
# a neutral you@example.com example).
INTERNAL_EMAIL_DOMAINS=

# --- Production only (docker-compose.prod.yml) ---
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# ORBIT_JIRA_WEBHOOK_SECRET=
# SNAPSHOT_SHARED_SECRET=
# GOOGLE_ALLOWED_DOMAINS=example.com
# FRONTEND_URL=https://orbit.example.com

# --- Hosts & ports (read by scripts/start-all.sh) ---
# Override any of these to run on a different host (e.g. an ngrok tunnel,
# a staging frontend, or a sidecar in a separate container).
# ORBIT_HOST=127.0.0.1
# ORBIT_BACKEND_PORT=8080
# ORBIT_FRONTEND_PORT=3000
# ORBIT_SIDECAR_PORT=3001

# Derived URLs — set these directly to override the host:port composition.
# ORBIT_BACKEND_URL=http://127.0.0.1:8080
# ORBIT_FRONTEND_URL=http://127.0.0.1:3000
# ORBIT_PUBLIC_BASE_URL=http://127.0.0.1:3000      # base for /snapshots/{id} links DMed via Slack
# SNAPSHOT_SIDECAR_URL=http://127.0.0.1:3001

# --- Demo data (opt-in) ---
# Set to true to have scripts/start-all.sh load the neutral demo dataset
# (scripts/seed-demo.sql: Acme Corp / Globex / Initech) after the backend
# boots. Fresh installs start empty. Idempotent — safe to leave enabled.
# SEED_DEMO_DATA=false

# --- Snapshot agent ---
# SNAPSHOT_RENDERER=mock      # set to `http` (or use --with-sidecar) to hit the Playwright sidecar
